# ---- Supabase (optional — app runs on mock data + mock user without it) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI summarization (optional — falls back to structured mock summaries) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Text-to-speech for the Watch tab (optional — falls back to silent caption cards) ----
OPENAI_API_KEY_TTS=

# ---- Admin page + ingestion endpoint protection ----
ADMIN_PASSWORD=change-me

# ---- Auto-set by Vercel when you enable Cron Jobs on the project; lets the
# scheduled /api/ingest run authenticate without ADMIN_PASSWORD. Optional locally. ----
CRON_SECRET=

# ---- Push notifications (optional — the daily morning brief).
# Generate a pair with: npx web-push generate-vapid-keys
# The private key must stay secret. ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
