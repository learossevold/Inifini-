node_modules/
.next/
.env*.local

# TypeScript incremental build cache: regenerated by every build, so it only
# ever shows up as noise in a diff.
*.tsbuildinfo

# ios/ itself (created by `npm run cap:add:ios`, once you have Xcode — see
# README's App Store section) is meant to be committed: it holds hand-edited
# Xcode project settings, signing config and Info.plist entries nothing else
# regenerates. Only what's reinstallable from it is ignored here.
ios/App/Pods/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
ios/.build/
